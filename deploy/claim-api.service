[Unit]
Description=Claim Detection API (FastAPI + DistilBERT)
Documentation=https://github.com/Spicerke/Claim_Detection
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=__USER__
Group=__USER__
WorkingDirectory=__REPO__/App

# Where the weights live on the Pi. They are NOT in the repo -- see deploy/README.md.
Environment="MODEL_DIR=__MODEL_DIR__"

# Origins allowed to call this API from a browser. Must include the GitHub Pages
# URL exactly, scheme included, no trailing slash. Comma-separated.
Environment="ALLOWED_ORIGINS=__ORIGINS__"

# A 4-core Pi: leave headroom so concurrent requests don't fight over cores.
Environment="TORCH_THREADS=2"
Environment="OMP_NUM_THREADS=2"

# Bind to loopback ONLY. cloudflared is the sole path in from the internet, which
# is what makes trusting the CF-Connecting-IP header for rate limiting safe.
# One worker: each worker loads its own ~270MB copy of the model.
ExecStart=__REPO__/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1

Restart=always
RestartSec=5
# Loading DistilBERT off an SD card is slow; don't let systemd give up early.
TimeoutStartSec=180

# Modest hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
